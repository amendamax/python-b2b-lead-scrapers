# Configurare Proxy (10 GB Residential/ISP Traffic Budget)
PROXY_URL="http://user:pass@proxy-host:port"

# Foloseste proxy pentru eMAG Marketplace (recomandat true cand PROXY_URL este setat)
USE_PROXY_FOR_EMAG=true

# Foloseste proxy pentru cele 10 magazine medii (implicit false pentru economisire trafic 10 GB;
# sistemul face fallback automat pe proxy doar daca un magazin returneaza HTTP 403 / 429 / Cloudflare challenge)
USE_PROXY_FOR_STORES=false

# Setari aditionale de politete si timeout
REQUEST_TIMEOUT_SEC=25
MIN_DELAY_SEC=2.0
MAX_DELAY_SEC=4.0
DB_PATH="radar_history.db"
OUTPUT_DIR="output"
